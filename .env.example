# Example environment variables for Ubuy backend
# Copy this file to `.env` and fill secrets before running locally or in CI.

# App
PORT=8080
NODE_ENV=development
ENABLE_ADMIN_TOOLS=true

# MongoDB
# Example: mongodb://user:pass@localhost:27017/ubuy
MONGO_URI=mongodb://localhost:27017/ubuy
MONGO_MAX_POOL_SIZE=120
MONGO_MIN_POOL_SIZE=20

# Redis (used for Socket.IO adapter and BullMQ)
REDIS_URL=redis://localhost:6379

# JWT / Auth
JWT_SECRET=replace_this_with_a_strong_random_value

# Payments
PAYMENT_WEBHOOK_SECRET=replace_this_with_the_provider_webhook_secret
PAYMENT_RETURN_URL=http://localhost:3000/payment-return
PAYMENT_NOTIFY_URL=http://localhost:3000/payment-notify

# Frontend
FRONTEND_BASE_URL=http://localhost:3000

# Third-party integrations (examples)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional runtime/debug
LOG_LEVEL=info
ENV_FILE=.env
