# Dedicated environment for local load/performance testing
PORT=8080

# Local MongoDB and Redis (docker-compose.local.yml)
MONGO_URI=mongodb://127.0.0.1:27017/ubuy_loadtest
REDIS_URL=redis://127.0.0.1:6379
MONGO_MAX_POOL_SIZE=120
MONGO_MIN_POOL_SIZE=20

# Hot public list endpoint response cache (milliseconds)
AUCTIONS_LIST_CACHE_TTL_MS=2000

# Required app secrets for local execution
JWT_SECRET=local-loadtest-jwt-secret-change-me
PAYMENT_WEBHOOK_SECRET=local-loadtest-webhook-secret

# Keep admin tools available locally for diagnostics
ENABLE_ADMIN_TOOLS=true

# Disable per-request HTTP logging during load tests to reduce overhead
HTTP_REQUEST_LOGS=false
